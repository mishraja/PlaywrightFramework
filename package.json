    "test:smoke:android": "playwright test -c src/config/playwright.config.ts --grep smoke --project=\"Mobile Chrome\"",
    "test:smoke:ios": "playwright test -c src/config/playwright.config.ts --grep smoke --project=\"Mobile Safari\"",
    "test:ui": "playwright test -c src/config/playwright.config.ts --ui",
    "test:report": "playwright show-report",
    "pw:install": "playwright install chromium"
